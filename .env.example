# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env

# Chave secreta do Flask (gere uma segura: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-por-uma-chave-muito-segura

# Senha do painel administrativo
ADMIN_PASSWORD=troque-por-senha-segura

# URL de conexão com PostgreSQL
# No Render, essa variável é injetada automaticamente ao linkar o banco.
# Para desenvolvimento local, use o formato abaixo:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/convite
DATABASE_URL=postgresql://usuario:senha@localhost:5432/convite

# Porta da aplicação (Render injeta automaticamente)
PORT=5000

# URL pública da aplicação (para keep-alive / self-ping)
# No Render, a variável RENDER_EXTERNAL_URL é injetada automaticamente.
# Se usar outro hosting, defina a URL aqui:
# APP_URL=https://seu-app.onrender.com
