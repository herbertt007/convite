# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env

# Chave secreta do Flask (gere uma segura: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-por-uma-chave-muito-segura

# Senha do painel administrativo
ADMIN_PASSWORD=troque-por-senha-segura

# Configurações do MySQL
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=sua-senha-aqui
MYSQL_DATABASE=convite
MYSQL_PORT=3306

# Ative SSL se o banco exigir (ex: Railway, PlanetScale)
# MYSQL_SSL=true

# Porta da aplicação (Railway injeta automaticamente)
PORT=5000
